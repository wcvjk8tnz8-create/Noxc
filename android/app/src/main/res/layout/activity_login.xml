<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="@string/login_title"
            android:textColor="@color/splash_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/login_email"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_input"
            android:hint="@string/login_email"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/bar_text"
            android:textColorHint="@color/bar_dim"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/login_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:background="@drawable/bg_input"
            android:hint="@string/login_password"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/bar_text"
            android:textColorHint="@color/bar_dim"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/login_remember"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="@string/login_remember"
            android:textColor="@color/bar_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/login_submit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_pill"
            android:text="@string/login_button"
            android:textColor="@color/bar_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/login_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/danger"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/login_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/login_register"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill"
                android:text="@string/login_register"
                android:textColor="@color/bar_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/login_forgot"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:text="@string/login_forgot"
                android:textColor="@color/bar_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/login_oauth_nodeloc"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:text="@string/login_oauth_nodeloc"
                android:textColor="@color/bar_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/login_oauth_github"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:text="@string/login_oauth_github"
                android:textColor="@color/bar_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
