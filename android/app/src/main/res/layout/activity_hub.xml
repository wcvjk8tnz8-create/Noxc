<?xml version="1.0" encoding="utf-8"?>
<!-- 功能中心：Bento 网格 + Lottie 主视觉 + 骨架屏，进入各功能页用共享元素转场 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/splash_bg" android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent" android:layout_height="220dp">

        <xyz.noxc.app.FxView
            android:id="@+id/hub_glow"
            android:layout_width="match_parent" android:layout_height="match_parent" />

        <ImageView
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:alpha="0.55"
            android:src="@drawable/art_hero" android:contentDescription="@string/hub_title" />

        <View android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@color/hero_scrim" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/hub_lottie"
            android:layout_width="104dp" android:layout_height="104dp"
            android:layout_gravity="end|top" android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:lottie_rawRes="@raw/anim_domain"
            app:lottie_autoPlay="true" app:lottie_loop="true" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:orientation="vertical"
            android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="16dp">

            <TextView android:id="@+id/hub_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/hub_title" android:textColor="@color/bar_text"
                android:textSize="30sp" android:textStyle="bold" />

            <TextView android:id="@+id/hub_sub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/hub_sub"
                android:textColor="@color/bar_dim" android:textSize="13sp" />
        </LinearLayout>

        <ImageButton android:id="@+id/hub_back"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="start|top" android:layout_margin="10dp"
            android:background="@drawable/bg_round_ghost"
            android:src="@drawable/ic_back" android:contentDescription="@string/common_cancel" />
    </FrameLayout>

    <LinearLayout android:id="@+id/hub_stats"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="16dp"
        android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="4dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/hub_n_groups"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/brand_dot"
                android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/hub_groups" android:textColor="@color/bar_dim" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/hub_n_screens"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/brand_dot"
                android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/hub_screens" android:textColor="@color/bar_dim" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/hub_n_endpoints"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/brand_dot"
                android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/hub_endpoints" android:textColor="@color/bar_dim" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <EditText android:id="@+id/hub_search"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp" android:layout_marginBottom="4dp"
        android:background="@drawable/bg_input" android:hint="@string/hub_search"
        android:textColor="@color/bar_text" android:textColorHint="@color/bar_dim"
        android:textSize="13sp" android:singleLine="true"
        android:paddingStart="14dp" android:paddingEnd="14dp" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/hub_swipe"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:id="@+id/hub_grid"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" />
            </androidx.core.widget.NestedScrollView>

            <!-- 骨架屏：数据回来前给页面框架，替代一直转圈 -->
            <xyz.noxc.app.FxView android:id="@+id/hub_skeleton"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_margin="16dp" android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout android:id="@+id/hub_footer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="8dp" android:paddingBottom="12dp">

        <TextView android:id="@+id/hub_motion"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/motion_reduce"
            android:textColor="@color/bar_dim" android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/hub_reduce"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>
</LinearLayout>
